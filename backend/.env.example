# Copier ce fichier en ".env" et adapter les valeurs.

# Fournisseur du LLM : "fake" (réponses simulées, pour développer/tester) ou "ollama"
LLM_PROVIDER=fake

# Modèle utilisé par Ollama
LLM_MODEL=qwen2.5:7b

# Adresse d'Ollama.
# - backend lancé directement sur la machine : http://localhost:11434
# - backend lancé dans Docker               : http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Modèle d'embeddings (transforme les textes en vecteurs pour la recherche)
# "fake" (vecteurs simulés, pour développer/tester) ou "ollama"
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=bge-m3
